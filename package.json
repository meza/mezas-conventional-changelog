{
  "name": "@meza/mezas-conventional-changelog",
  "version": "0.0.0",
  "description": "Meza's custom Conventional Changelog preset",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "repository": {
    "url": "https://github.com/meza/mezas-conventional-changelog"
  },
  "exports": {
    ".": {
      "import": {
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "require": {
        "import": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint:ci": "biome ci --reporter=github .",
    "lint:types": "tsc --noEmit",
    "lint:package": "publint",
    "lint": "run-s lint:ci lint:types lint:package",
    "lint:fix": "biome check --fix",
    "release": "semantic-release",
    "test": "vitest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "conventional-changelog-conventionalcommits": "^9.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@meza/biome": "^1.1.1",
    "@meza/tsconfig-base": "^1.1.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "^24.11.0",
    "@typescript/native-preview": "7.0.0-dev.20260324.1",
    "@vitest/coverage-v8": "^4.0.15",
    "is-ci": "^4.1.0",
    "npm-run-all2": "^8.0.4",
    "pnpm": "^10.33.0",
    "publint": "^0.3.15",
    "semantic-release": "^25.0.2",
    "semantic-release-export-data": "^1.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.0",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": false,
    "clean": true,
    "treeshake": true,
    "format": [
      "cjs",
      "esm"
    ]
  }
}
