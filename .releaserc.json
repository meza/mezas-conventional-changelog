{
  "branches": [
    "+([0-9])?(.{+([0-9]),x}).x",
    "main",
    {
      "name": "next",
      "prerelease": true
    },
    {
      "name": "beta",
      "prerelease": true
    },
    {
      "name": "alpha",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "./dist/index.cjs"
      }
    ],
    "semantic-release-export-data",
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "./dist/index.cjs"
      }
    ],
    "@semantic-release/npm",
    ["@semantic-release/github"]
  ]
}
